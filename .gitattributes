# Git attributes for Helga project
# Ensures consistent line endings and proper handling of different file types

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.rst text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.bash text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pyc binary
*.pyo binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.egg binary
*.whl binary

# Archive files
*.7z binary
*.gz binary
*.tar binary
*.zip binary

# Linguist overrides for GitHub language statistics
*.mustache linguist-language=HTML
docs/** linguist-documentation
helga/tests/** linguist-generated=false

# Git diff settings
*.py diff=python
*.md diff=markdown
*.rst diff=markdown

# Export ignore (files not included in git archive)
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.pre-commit-config.yaml export-ignore
.travis.yml export-ignore
.coveragerc export-ignore
.flake8 export-ignore
tox.ini export-ignore
setup-dev.sh export-ignore
PHASE1_COMPLETE.md export-ignore
CONTRIBUTING.md export-ignore
MODERNIZATION.md export-ignore

